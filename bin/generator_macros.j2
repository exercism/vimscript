{%- macro render_var_assignment(name, value) -%}
  {%- if value is sequence and not value is string and (value | length > 15 or value | quote | length > 80)  -%}
  {%- if value[0] | quote | length > 10 %}{% set batch_size = 1 %}{% else %}{% set batch_size = 15 %}{% endif -%}
  let g:{{ name }} = [
    {%- for elements in value | batch(batch_size) %}
  \ {{ elements | map("quote") | join(", ") }}{% if not loop.last %},{% endif %}
    {%- endfor %}
  \ ]
  {%- else -%}
  let g:{{ name }} = {{ value | quote }}
  {%- endif -%}
{%- endmacro -%}


{%- macro test_equal(case, function, params) -%}
Execute ({{ case.descriptions | join(": ") | replace(":: ", ": ") }}):
 {%- for param in params %}
  {{ render_var_assignment(param, case.input[param]) }}
 {%- endfor %}
 {%- if not case.expect_error %}
  {{ render_var_assignment("expected", case.expected) }}
  AssertEqual g:expected, {{ function }}({% for param in params %}g:{{param}}{% if not loop.last %}, {% endif %}{% endfor %})
 {%- else %}
  let g:expected = {{ case.expect_error_msg | quote }}
  AssertThrows call {{ function }}({% for param in params %}g:{{param}}{% if not loop.last %}, {% endif %}{% endfor %})
  AssertEqual g:expected, g:vader_exception
 {%- endif %}
{%- endmacro -%}
