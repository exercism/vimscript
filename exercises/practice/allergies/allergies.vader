Execute (list when: no allergies):
  let g:score = 0
  let g:expected = []
  AssertEqual g:expected, List(g:score)

Execute (list when: just eggs):
  let g:score = 1
  let g:expected = ["eggs"]
  AssertEqual g:expected, List(g:score)

Execute (list when: just peanuts):
  let g:score = 2
  let g:expected = ["peanuts"]
  AssertEqual g:expected, List(g:score)

Execute (list when: just strawberries):
  let g:score = 8
  let g:expected = ["strawberries"]
  AssertEqual g:expected, List(g:score)

Execute (list when: eggs and peanuts):
  let g:score = 3
  let g:expected = ["eggs", "peanuts"]
  AssertEqual g:expected, List(g:score)

Execute (list when: more than eggs but not peanuts):
  let g:score = 5
  let g:expected = ["eggs", "shellfish"]
  AssertEqual g:expected, List(g:score)

Execute (list when: lots of stuff):
  let g:score = 248
  let g:expected = ["strawberries", "tomatoes", "chocolate", "pollen", "cats"]
  AssertEqual g:expected, List(g:score)

Execute (list when: everything):
  let g:score = 255
  let g:expected = [
  \ "eggs", "peanuts", "shellfish", "strawberries", "tomatoes", "chocolate", "pollen", "cats"
  \ ]
  AssertEqual g:expected, List(g:score)

Execute (list when: no allergen score parts):
  let g:score = 509
  let g:expected = ["eggs", "shellfish", "strawberries", "tomatoes", "chocolate", "pollen", "cats"]
  AssertEqual g:expected, List(g:score)

Execute (list when: no allergen score parts without highest valid score):
  let g:score = 257
  let g:expected = ["eggs"]
  AssertEqual g:expected, List(g:score)
