Execute (the sound for 1 is 1):
  let g:number = 1
  let g:expected = "1"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 3 is Pling):
  let g:number = 3
  let g:expected = "Pling"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 5 is Plang):
  let g:number = 5
  let g:expected = "Plang"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 7 is Plong):
  let g:number = 7
  let g:expected = "Plong"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 6 is Pling as it has a factor 3):
  let g:number = 6
  let g:expected = "Pling"
  AssertEqual g:expected, Raindrops(g:number)

Execute (2 to the power 3 does not make a raindrop sound as 3 is the exponent not the base):
  let g:number = 8
  let g:expected = "8"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 9 is Pling as it has a factor 3):
  let g:number = 9
  let g:expected = "Pling"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 10 is Plang as it has a factor 5):
  let g:number = 10
  let g:expected = "Plang"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 14 is Plong as it has a factor of 7):
  let g:number = 14
  let g:expected = "Plong"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 15 is PlingPlang as it has factors 3 and 5):
  let g:number = 15
  let g:expected = "PlingPlang"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 21 is PlingPlong as it has factors 3 and 7):
  let g:number = 21
  let g:expected = "PlingPlong"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 25 is Plang as it has a factor 5):
  let g:number = 25
  let g:expected = "Plang"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 27 is Pling as it has a factor 3):
  let g:number = 27
  let g:expected = "Pling"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 35 is PlangPlong as it has factors 5 and 7):
  let g:number = 35
  let g:expected = "PlangPlong"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 49 is Plong as it has a factor 7):
  let g:number = 49
  let g:expected = "Plong"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 52 is 52):
  let g:number = 52
  let g:expected = "52"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 105 is PlingPlangPlong as it has factors 3, 5 and 7):
  let g:number = 105
  let g:expected = "PlingPlangPlong"
  AssertEqual g:expected, Raindrops(g:number)

Execute (the sound for 3125 is Plang as it has a factor 5):
  let g:number = 3125
  let g:expected = "Plang"
  AssertEqual g:expected, Raindrops(g:number)
