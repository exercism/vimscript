Execute (empty sentence):
  let g:sentence = ""
  let g:expected = 0
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (perfect lower case):
  let g:sentence = "abcdefghijklmnopqrstuvwxyz"
  let g:expected = 1
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (only lower case):
  let g:sentence = "the quick brown fox jumps over the lazy dog"
  let g:expected = 1
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (missing the letter 'x'):
  let g:sentence = "a quick movement of the enemy will jeopardize five gunboats"
  let g:expected = 0
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (missing the letter 'h'):
  let g:sentence = "five boxing wizards jump quickly at it"
  let g:expected = 0
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (with underscores):
  let g:sentence = "the_quick_brown_fox_jumps_over_the_lazy_dog"
  let g:expected = 1
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (with numbers):
  let g:sentence = "the 1 quick brown fox jumps over the 2 lazy dogs"
  let g:expected = 1
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (missing letters replaced by numbers):
  let g:sentence = "7h3 qu1ck brown fox jumps ov3r 7h3 lazy dog"
  let g:expected = 0
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (mixed case and punctuation):
  let g:sentence = "\"Five quacking Zephyrs jolt my wax bed.\""
  let g:expected = 1
  AssertEqual g:expected, IsPangram(g:sentence)

Execute (a-m and A-M are 26 different characters but not a pangram):
  let g:sentence = "abcdefghijklm ABCDEFGHIJKLM"
  let g:expected = 0
  AssertEqual g:expected, IsPangram(g:sentence)
