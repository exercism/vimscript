Execute (finds the largest product if span equals length):
  let g:digits = "29"
  let g:span = 2
  let g:expected = 18
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (can find the largest product of 2 with numbers in order):
  let g:digits = "0123456789"
  let g:span = 2
  let g:expected = 72
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (can find the largest product of 2):
  let g:digits = "576802143"
  let g:span = 2
  let g:expected = 48
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (can find the largest product of 3 with numbers in order):
  let g:digits = "0123456789"
  let g:span = 3
  let g:expected = 504
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (can find the largest product of 3):
  let g:digits = "1027839564"
  let g:span = 3
  let g:expected = 270
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (can find the largest product of 5 with numbers in order):
  let g:digits = "0123456789"
  let g:span = 5
  let g:expected = 15120
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (can get the largest product of a big number):
  let g:digits = "73167176531330624919225119674426574742355349194934"
  let g:span = 6
  let g:expected = 23520
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (reports zero if the only digits are zero):
  let g:digits = "0000"
  let g:span = 2
  let g:expected = 0
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (reports zero if all spans include zero):
  let g:digits = "99099"
  let g:span = 3
  let g:expected = 0
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (rejects span longer than string length):
  let g:digits = "123"
  let g:span = 4
  let g:expected = -1
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (rejects empty string and nonzero span):
  let g:digits = ""
  let g:span = 1
  let g:expected = -1
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (rejects invalid character in digits):
  let g:digits = "1234a5"
  let g:span = 2
  let g:expected = -1
  AssertEqual g:expected, LargestProduct(g:digits, g:span)

Execute (rejects negative span):
  let g:digits = "12345"
  let g:span = -1
  let g:expected = -1
  AssertEqual g:expected, LargestProduct(g:digits, g:span)
