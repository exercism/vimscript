{%- import "generator_macros.j2" as macros -%}

{% for case in cases %}
Execute ({{ case.description }}):
 {%- for param in case.input.keys() %}
  let g:{{ param }} = {{ case.input[param] | quote }}
 {%- endfor %}
 {%- if not case.expect_error %}
  let g:expected = {{ case.expected | quote }}
 {%- else %}
  let g:expected = -1
 {%- endif %}
  AssertEqual g:expected, {{ case.property_function }}({% for param in case.input.keys() %}g:{{param}}{% if not loop.last %}, {% endif %}{% endfor %})
{% endfor %}
